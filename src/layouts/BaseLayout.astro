---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { dict } from '../i18n/dict';
import { LANG_HTML, LANG_OG } from '../i18n/config';
import type { Lang } from '../i18n/config';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang: Lang;
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, lang, bodyClass = '', jsonLd } = Astro.props;
const d = dict(lang);
const fullTitle = title ? `${title} · ${d.site.short}` : `${d.site.name} · ${d.site.tagline}`;
const desc = description ?? d.home.heroSubtitle;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hatdf.org').toString();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: d.site.name,
  alternateName: d.site.short,
  url: 'https://hatdf.org',
  logo: 'https://hatdf.org/logo.png',
  description: d.footer.description,
  email: 'mailto:info@hatdf.org.hk',
  telephone: '+852 6113 0828',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1/F & 2/F, 228 Electric Road, North Point',
    addressLocality: 'Hong Kong',
    addressCountry: 'HK',
  },
};

const allJsonLd = jsonLd ? (Array.isArray(jsonLd) ? [orgJsonLd, ...jsonLd] : [orgJsonLd, jsonLd]) : [orgJsonLd];
---

<!doctype html>
<html lang={LANG_HTML[lang]} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="alternate" hreflang="zh-HK" href={canonical.replace(/\/(zh|en)\//, '/hk/')} />
    <link rel="alternate" hreflang="zh-CN" href={canonical.replace(/\/(hk|en)\//, '/zh/')} />
    <link rel="alternate" hreflang="en" href={canonical.replace(/\/(hk|zh)\//, '/en/')} />
    <link rel="alternate" hreflang="x-default" href={canonical.replace(/\/(zh|en)\//, '/hk/')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+TC:wght@300;400;500;700;900&family=Noto+Serif+TC:wght@400;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_OG[lang]} />
    <meta property="og:site_name" content={d.site.short} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    <title>{fullTitle}</title>

    {allJsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">{d.common.skipToContent}</a>
    <NavBar lang={lang} />
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>