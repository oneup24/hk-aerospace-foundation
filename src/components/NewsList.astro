---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import Section from './Section.astro';
import NewsCard from './NewsCard.astro';
import { dict } from '../i18n/dict';
import type { Lang } from '../i18n/config';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);

const news = (await getCollection('news', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout lang={lang} title={d.news.pageTitle} description={d.news.pageLead}>
  <section class="bg-canvas border-b border-hairline">
    <Container>
      <div class="py-20 md:py-28 max-w-4xl">
        <p class="label-upper text-[11px] text-gold mb-6 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-gold"></span>
          {d.news.pageEyebrow}
        </p>
        <h1 class="text-4xl md:text-display-lg font-bold text-ink leading-[1.05] tracking-tight text-balance">
          {d.news.pageTitle}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-body leading-relaxed max-w-3xl">{d.news.pageLead}</p>
      </div>
    </Container>
  </section>

  <Section pad="lg">
    <Container>
      {news.length === 0 ? (
        <p class="text-body text-lg">{d.news.emptyState}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {news.map((n) => (
            <NewsCard
              href={`/${lang}/news/${n.slug.replace(new RegExp(`^${lang}/`), '')}`}
              category={n.data.category}
              title={n.data.title}
              excerpt={n.data.excerpt}
              date={n.data.date}
              lang={lang}
            />
          ))}
        </div>
      )}
    </Container>
  </Section>
</BaseLayout>