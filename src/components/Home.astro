---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import Section from './Section.astro';
import StatBlock from './StatBlock.astro';
import NewsCard from './NewsCard.astro';
import HeroSlider from './HeroSlider.astro';
import { dict } from '../i18n/dict';
import { langPath } from '../i18n/config';
import type { Lang } from '../i18n/config';

export interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);

const news = (await getCollection('news', ({ id }) => id.startsWith(`${lang}/`)))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const pillars = [
  { title: d.home.pillar1Title, desc: d.home.pillar1Desc, num: '01' },
  { title: d.home.pillar2Title, desc: d.home.pillar2Desc, num: '02' },
  { title: d.home.pillar3Title, desc: d.home.pillar3Desc, num: '03' },
  { title: d.home.pillar4Title, desc: d.home.pillar4Desc, num: '04' },
];
---

<BaseLayout lang={lang} description={d.home.heroSubtitle}>
  <HeroSlider lang={lang} />

  <section class="bg-canvas border-b border-hairline">
    <Container>
      <div class="py-16 md:py-24 grid md:grid-cols-12 gap-10 md:gap-16 items-end">
        <div class="md:col-span-8">
          <p class="label-upper text-[11px] text-gold mb-6 flex items-center gap-3">
            <span class="inline-block w-8 h-px bg-gold"></span>
            {d.home.heroEyebrow}
          </p>
          <h1 class="text-4xl sm:text-5xl md:text-display-lg lg:text-display-xl font-bold leading-[1] tracking-tight text-ink text-balance">
            {d.home.heroTitle}
          </h1>
          <p class="mt-5 text-2xl md:text-3xl font-serif text-gold leading-tight tracking-tight">
            {d.site.tagline}
          </p>
        </div>
        <div class="md:col-span-4">
          <p class="text-base md:text-lg text-body-strong leading-relaxed">{d.home.heroSubtitle}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={langPath(lang, 'about')} class="btn btn-gold">
              {d.home.heroCtaPrimary}
              <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href={langPath(lang, 'news')} class="btn btn-primary-outline">
              {d.home.heroCtaSecondary}
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Section bg="surface" pad="md">
    <Container>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <StatBlock number={d.home.stat1Number} label={d.home.stat1Label} />
        <StatBlock number={d.home.stat2Number} label={d.home.stat2Label} />
        <StatBlock number={d.home.stat3Number} label={d.home.stat3Label} />
        <StatBlock number={d.home.stat4Number} label={d.home.stat4Label} />
      </div>
    </Container>
  </Section>

  <Section pad="lg">
    <Container>
      <div class="grid md:grid-cols-12 gap-10 md:gap-16">
        <div class="md:col-span-5">
          <p class="label-upper text-[11px] text-gold mb-5">{d.home.whyEyebrow}</p>
          <h2 class="text-3xl md:text-display-md font-bold text-ink leading-[1.1] tracking-tight text-balance">
            {d.home.whyTitle}
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-lg md:text-xl text-body-strong leading-relaxed mb-6">{d.home.whyLead}</p>
          <p class="text-lg md:text-xl text-body leading-relaxed">{d.home.whyBody}</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section bg="surface-soft" pad="lg">
    <Container>
      <div class="mb-12 md:mb-16 max-w-3xl">
        <p class="label-upper text-[11px] text-gold mb-5">{d.home.missionEyebrow}</p>
        <h2 class="text-3xl md:text-display-md font-bold text-ink leading-[1.1] tracking-tight text-balance">
          {d.home.missionTitle}
        </h2>
        <p class="mt-5 text-lg text-body leading-relaxed">{d.home.missionLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p) => (
          <article class="bg-canvas border border-hairline hover:border-gold transition-colors p-7 group shadow-soft hover:shadow-elev">
            <span class="label-upper text-[10px] text-gold">{p.num}</span>
            <h3 class="mt-4 text-xl font-bold text-ink group-hover:text-gold transition-colors">{p.title}</h3>
            <p class="mt-3 text-sm text-body leading-relaxed">{p.desc}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section pad="lg">
    <Container>
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <div class="max-w-2xl">
          <p class="label-upper text-[11px] text-gold mb-5">{d.home.insightsEyebrow}</p>
          <h2 class="text-3xl md:text-display-md font-bold text-ink leading-[1.1] tracking-tight">
            {d.home.insightsTitle}
          </h2>
          <p class="mt-5 text-lg text-body leading-relaxed">{d.home.insightsLead}</p>
        </div>
        <a href={langPath(lang, 'news')} class="text-link-upper text-[11px]">
          {d.common.viewAll} {d.nav.news} →
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {news.map((n) => (
          <NewsCard
            href={langPath(lang, `news/${n.slug.replace(new RegExp(`^${lang}/`), '')}`)}
            category={n.data.category}
            title={n.data.title}
            excerpt={n.data.excerpt}
            date={n.data.date}
            lang={lang}
            image={n.data.image}
          />
        ))}
      </div>
    </Container>
  </Section>

  <section class="bg-surface border-t border-hairline">
    <Container>
      <div class="py-24 md:py-32 text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-display-md font-bold text-ink leading-[1.1] tracking-tight text-balance">
          {d.home.ctaTitle}
        </h2>
        <p class="mt-6 text-lg text-body leading-relaxed">{d.home.ctaBody}</p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href={langPath(lang, 'contact')} class="btn btn-gold">
            {d.home.ctaPrimary}
            <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={langPath(lang, 'news')} class="btn btn-primary-outline">{d.home.ctaSecondary}</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>