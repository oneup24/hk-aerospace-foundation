---
export interface Props {
  href: string;
  category: string;
  title: string;
  excerpt: string;
  date: Date;
  lang?: 'hk' | 'zh' | 'en';
}
const { href, category, title, excerpt, date, lang = 'hk' } = Astro.props;
const formatted = date.toLocaleDateString(lang === 'en' ? 'en-GB' : 'zh-HK', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a href={href} class="group block bg-surface border border-hairline hover:border-gold overflow-hidden transition">
  <div class="aspect-[16/10] bg-navy relative overflow-hidden grid place-items-center">
    <svg class="w-20 h-20 text-gold/40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2L4 12h5v8h6v-8h5L12 2z"/>
    </svg>
    <span class="absolute top-4 left-4 label-upper text-[10px] bg-gold text-navy px-2.5 py-1">
      {category}
    </span>
  </div>
  <div class="p-6 md:p-7">
    <time class="text-muted label-upper text-[10px]" datetime={date.toISOString()}>{formatted}</time>
    <h3 class="mt-3 text-lg md:text-xl font-bold text-ink group-hover:text-gold transition leading-snug">
      {title}
    </h3>
    <p class="mt-3 text-body text-sm leading-relaxed line-clamp-2">{excerpt}</p>
    <span class="mt-5 inline-flex items-center label-upper text-[10px] text-gold gap-2">
      {lang === 'en' ? 'READ MORE' : '閱讀全文'}
      <svg class="w-3 h-3 -translate-x-1 group-hover:translate-x-0 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
