---
export interface Props {
  number: string;
  label: string;
  suffix?: string;
  source?: string;
}
const { number, label, suffix, source } = Astro.props;
---
<div class="border-l border-hairline-strong pl-5 py-2">
  <div class="flex items-baseline gap-1">
    <span class="text-4xl sm:text-5xl md:text-display-md font-bold text-ink leading-none tracking-tight">{number}</span>
    {suffix && <span class="text-base md:text-xl text-gold font-bold">{suffix}</span>}
  </div>
  <div class="mt-3 label-upper text-[11px] text-muted leading-snug">{label}</div>
  {source && <div class="mt-1.5 text-[10px] text-muted leading-snug italic">{source}</div>}
</div>